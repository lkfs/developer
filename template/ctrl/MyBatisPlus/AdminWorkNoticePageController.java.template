package ${ctrlPackage};

import ${sdkModulePackage}.dao.entity.${entityClassName};
import ${sdkModulePackage}.dao.mapper.${managerClassName};
import ${qoPackage}.${qoClassName};
import ${voPackage}.${voClassName};
import com.baomidou.mybatisplus.core.metadata.IPage;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;
import com.github.yulichang.wrapper.MPJLambdaWrapper;
import io.github.lkfs.developer.common.exception.BizException;
import io.github.lkfs.developer.common.result.CommonResult;
import io.github.lkfs.developer.common.result.ICommonResult;
import io.github.lkfs.developer.common.security.IBaseUser;
import io.github.lkfs.developer.common.security.SecurityUtils;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.media.Content;
import io.swagger.v3.oas.annotations.media.Schema;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.responses.ApiResponses;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.annotation.Resource;
import jakarta.servlet.http.HttpServletRequest;
import lombok.extern.slf4j.Slf4j;
import org.springframework.util.ObjectUtils;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;
import java.util.Optional;

/**
 * TODO
 *
 * @author : lkfs
 * @date : ${new Date().format("yyyy-MM-dd HH:mm")}
 */

@RestController
@RequestMapping("${context}")
@Slf4j
@Tag(name = "${tags}", description = "")
public class ${ctrlClassName} {
    @Resource
    private ${managerClassName} ${managerObjectName};

    @PostMapping("/${route}")
    @Operation(summary = "分页查询", description = "")
    @ApiResponses(value = {@ApiResponse(responseCode = "200", content = {@Content(schema = @Schema(implementation = ${voClassName}.class), mediaType = "application/json")})})
    public ICommonResult exec(
            @RequestBody @Parameter(required = true) @Validated ${qoClassName} qo,
            @RequestHeader(required = false) @Parameter(hidden = true) String platform,
            @RequestHeader(required = false) @Parameter(hidden = true) String version,
            @RequestHeader(required = false, name = "Accept-Language") @Parameter(hidden = true)  String language,
            HttpServletRequest request) {

        IBaseUser<String> curUser = Optional.ofNullable(SecurityUtils.getUser(String.class)).orElseThrow(() -> BizException.DATA_NOT_FOUND.withMessage("The user does not exists"));

        MPJLambdaWrapper<${entityClassName}> wrapper = new MPJLambdaWrapper<${entityClassName}>()
                .eq(!ObjectUtils.isEmpty(qo.${idGetMethod}()), ${entityClassName}::${idGetMethod}, qo.${idGetMethod}())
                .orderByAsc(${entityClassName}::getSort)
                .orderByDesc(${entityClassName}::getCreatedAt);
        IPage<${voClassName}> result = ${managerObjectName}.selectJoinPage(qo.getPage(), ${voClassName}.class, wrapper);

        return new CommonResult<>(result);

    }
}
